# Copy this file to .env and replace every production value.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=StudentManagementDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sms_user
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
PUBLIC_BASE_URL=https://your-api-domain.example
