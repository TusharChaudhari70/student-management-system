# Copy this file to .env and replace every production value.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=StudentManagementDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sms_user
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
PUBLIC_BASE_URL=https://your-api-domain.example

# Set to true only for a fresh installation. The account is created only when
# no ADMIN account exists yet.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
INITIAL_ADMIN_NAME=Administrator

# Optional local demo accounts (teacher1, teacher2, student1, student2).
# Never enable predictable credentials in a shared or production environment.
DEMO_DATA_ENABLED=false
DEMO_DATA_PASSWORD=Demo@12345
