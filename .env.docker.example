# Copy these values into Student_Management/.env. Do not commit real secrets.
# Docker Compose reads that file for every service that needs these values.
DB_USERNAME=sms_user
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200
PUBLIC_BASE_URL=http://localhost:8080

# This hostname is the SQL Server Compose service, not localhost.
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=StudentManagementDB;encrypt=true;trustServerCertificate=true

# SQL Server requires its own strong SA password; use a different password.
MSSQL_SA_PASSWORD=replace-with-a-strong-SA-password

# Local Docker demo accounts. These values are intentionally public test credentials;
# never enable them outside local development.
# The records are created only when their usernames/emails do not already exist.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_ADMIN_NAME=Administrator
DEMO_DATA_ENABLED=true
DEMO_DATA_PASSWORD=Demo@12345
